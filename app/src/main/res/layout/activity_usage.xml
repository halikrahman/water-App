<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:id="@+id/main"
    android:background="@drawable/su1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:orientation="vertical">

        <ImageView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginBottom="20dp"
            android:src="@drawable/s1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:paddingBottom="10dp"
            android:text="@string/Settings"
            android:textColor="@color/black"
            android:textSize="48sp"
            android:textStyle="bold" />

        <!-- Water Usage Limit Slider -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#2196F3"
            android:paddingBottom="5dp"
            android:text="@string/set_daily_water_usage_limit_liters"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/seekBar_water_limit"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@color/black"
            android:backgroundTint="@color/black"
            android:max="100"
            android:outlineProvider="paddedBounds"
            android:padding="10dp"
            android:progress="50"
            android:scrollbarSize="4dp" />

        <TextView
            android:id="@+id/txt_water_limit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:paddingBottom="15dp"
            android:text="@string/_50_liters"
            android:textAllCaps="true"
            android:textColor="@color/black"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Water Source Selection -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:paddingBottom="5dp"
            android:text="@string/preferred_water_source"
            android:textColor="@color/black"
            android:textSize="34sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/radioGroup_water_source"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#03A9F4"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/radio_rainwater"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rainwater_harvesting"
                android:textSize="20sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/radio_groundwater"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/groundwater"
                android:textSize="20sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/radio_tapwater"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tap_water"
                android:textSize="20sp"
                android:textStyle="bold" />
        </RadioGroup>

        <!-- Water Reminder Switch -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:paddingTop="10dp"
            android:text="@string/enable_daily_water_reminders"
            android:textColor="@color/black"
            android:textSize="24sp"
            android:textStyle="bold" />

        <Switch
            android:id="@+id/switch_water_reminder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#2196F3"
            android:text="@string/enable_reminders"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:ignore="UseSwitchCompatOrMaterialXml" />

        <!-- Save Button -->
        <Button
            android:id="@+id/button_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:text="@string/Save_settings"
            android:textColor="@color/black"
            android:textSize="24sp"
            android:textStyle="bold" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:onClick="openAboutUs"
            android:text="@string/About_us"
            android:textColor="@color/black"
            android:textSize="24sp"
            android:textStyle="bold" />


    </LinearLayout>

</ScrollView>